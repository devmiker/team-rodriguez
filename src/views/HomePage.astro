---
/**
 * The home page.
 *
 * Structure follows the order a sceptical small-business owner actually asks things
 * in: what is this, why should I believe you, what does it cost me to find out, who
 * are you, and how do I start. Sections that have no real content yet — work,
 * partners — are simply absent rather than present and empty.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ServiceCard from "../components/ServiceCard.astro";
import TeamCard from "../components/TeamCard.astro";
import Scenery from "../components/Scenery.astro";
import PartnerCard from "../components/PartnerCard.astro";
import { toLocale } from "../i18n/locales";
import { pathFor } from "../i18n/routes";
import { useTranslations } from "../i18n/ui";
import { SERVICES } from "../data/services";
import { publishedTeam } from "../data/team";
import { publishedPartners } from "../data/partners";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const team = publishedTeam();
const partners = publishedPartners();

const proofPoints = [
  { icon: "gauge", text: t("home.proof.speed") },
  { icon: "shield", text: t("home.proof.a11y") },
  { icon: "check", text: t("home.proof.own") },
] as const;

const steps = [1, 2, 3, 4] as const;
---

<BaseLayout page={{ route: "home" }} title={t("home.title")} description={t("home.description")}>
  {/* --- Hero ---
      Two columns on a wide screen: the pitch on the left, and on the right the three
      things every site ships with, as a card standing in the landscape. The card is
      the existing proof points, not a mock-up — nothing on it is invented. */}
  <section class="hero">
    <Scenery seed="home" critter="owl" />
    <div class="page hero__inner" data-enter>
      <div class="hero__copy">
        <p class="eyebrow">
          <span aria-hidden="true">&lt;</span>{t("home.hero.eyebrow")}<span aria-hidden="true"
            >&nbsp;/&gt;</span
          >
        </p>
        <h1>{t("home.hero.heading")}</h1>
        <p class="lead hero__body">{t("home.hero.body")}</p>
        <div class="hero__actions">
          <a class="button button--primary" href={pathFor({ route: "contact" }, locale)}>
            {t("home.hero.cta")}
            <Icon name="arrowRight" size="1.05em" />
          </a>
          <a class="button button--secondary" href={pathFor({ route: "services" }, locale)}>
            {t("home.hero.ctaSecondary")}
          </a>
        </div>
      </div>

      <aside class="spec" aria-labelledby="home-spec">
        <p class="eyebrow" id="home-spec">
          <span aria-hidden="true">&lt;</span>{t("home.proof.heading")}<span aria-hidden="true"
            >&nbsp;/&gt;</span
          >
        </p>
        <ul class="proof">
          {
            proofPoints.map((point) => (
              <li>
                <Icon name={point.icon} size="1.5rem" class="proof__icon" />
                <span>{point.text}</span>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  {/* --- Services --- */}
  <section class="section" aria-labelledby="home-services">
    <div class="page">
      <div data-reveal="text">
        <p class="eyebrow">{t("home.services.eyebrow")}</p>
        <h2 id="home-services">{t("home.services.heading")}</h2>
        <p class="lead section__lead">{t("home.services.body")}</p>
      </div>

      <div class="grid grid--4 section__body" data-reveal-group>
        {SERVICES.map((service) => <ServiceCard service={service} locale={locale} />)}
      </div>

      <p class="section__more" data-reveal="text">
        <a href={pathFor({ route: "services" }, locale)} class="more-link">
          {t("home.services.cta")}
          <Icon name="arrowRight" size="1em" />
        </a>
      </p>
    </div>
  </section>

  {/* --- Process --- */}
  <section class="section band on-band ridge-edge" aria-labelledby="home-process">
    <Scenery seed="home-process" variant="band" />
    <div class="page">
      <div data-reveal="text">
        <p class="eyebrow">{t("home.process.eyebrow")}</p>
        <h2 id="home-process">{t("home.process.heading")}</h2>
        <p class="lead section__lead">{t("home.process.body")}</p>
      </div>

      {/* An ordered list, because the steps happen in this order and that fact should
          reach a screen reader as structure rather than as visual numbering. */}
      <ol class="steps section__body" data-reveal-group>
        {
          steps.map((n) => (
            <li class="step">
              <p class="step__number" aria-hidden="true">
                {String(n).padStart(2, "0")}
              </p>
              <h3 class="step__title">
                {t(`home.process.${n}.title` as Parameters<typeof t>[0])}
              </h3>
              <p class="step__body">{t(`home.process.${n}.body` as Parameters<typeof t>[0])}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* --- Team. Absent entirely while nobody is published. --- */}
  {
    team.length > 0 && (
      <section class="section section--mist" aria-labelledby="home-team">
        <div class="page">
          <div data-reveal="text">
            <p class="eyebrow">{t("home.team.eyebrow")}</p>
            <h2 id="home-team">{t("home.team.heading")}</h2>
            <p class="lead section__lead">{t("home.team.body")}</p>
          </div>

          <div class="grid grid--3 grid--top section__body" data-reveal-group>
            {team.slice(0, 3).map((member) => (
              <TeamCard member={member} locale={locale} />
            ))}
          </div>

          <p class="section__more" data-reveal="text">
            <a href={pathFor({ route: "team" }, locale)} class="more-link">
              {t("home.team.cta")}
              <Icon name="arrowRight" size="1em" />
            </a>
          </p>
        </div>
      </section>
    )
  }

  {/* --- Partners. Same rule. --- */}
  {
    partners.length > 0 && (
      <section class="section" aria-labelledby="home-partners">
        <div class="page">
          <div data-reveal="text">
            <p class="eyebrow">{t("home.partners.eyebrow")}</p>
            <h2 id="home-partners">{t("home.partners.heading")}</h2>
            <p class="lead section__lead">{t("home.partners.body")}</p>
          </div>

          <div class="grid grid--3 section__body" data-reveal-group>
            {partners.slice(0, 3).map((partner) => (
              <PartnerCard partner={partner} locale={locale} />
            ))}
          </div>

          <p class="section__more" data-reveal="text">
            <a href={pathFor({ route: "partners" }, locale)} class="more-link">
              {t("home.partners.cta")}
              <Icon name="arrowRight" size="1em" />
            </a>
          </p>
        </div>
      </section>
    )
  }

  {/* --- Closing call to action --- */}
  <section class="section section--loose band on-band ridge-edge cta" aria-labelledby="home-cta">
    <Scenery seed="home-cta" variant="band" />
    <div class="page cta__inner" data-reveal>
      <h2 id="home-cta">{t("home.cta.heading")}</h2>
      <p class="lead">{t("home.cta.body")}</p>
      <a class="button button--primary" href={pathFor({ route: "contact" }, locale)}>
        {t("home.cta.button")}
        <Icon name="arrowRight" size="1.05em" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    --scene-forest: clamp(5.5rem, 15vw, 11rem);
    --scene-body: clamp(3.5rem, 9vw, 7rem);
    /* The sun or moon stands behind the spec card's top corner, so the card reads
       as standing in the landscape. On a phone it moves to the top-right corner. */
    --scene-body-end: calc(38% - var(--scene-body));
    --scene-body-top: var(--space-6);
    position: relative;
    isolation: isolate;
    padding-block: var(--rhythm) calc(var(--rhythm-tight) + var(--scene-forest));
    background: var(--color-sky);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .hero__inner h1 {
    margin-block-start: var(--space-4);
    font-size: var(--step-hero);
    max-width: 15ch;
  }

  .hero .eyebrow {
    font-weight: var(--weight-semibold);
    color: var(--color-link);
  }

  .hero__body {
    margin-block-start: var(--space-6);
    max-width: 52ch;
    color: var(--color-text);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-8);
  }

  /* --- The spec card --- */

  .spec {
    position: relative;
    padding: var(--space-6);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 60rem) {
    .spec {
      margin-block-start: var(--space-16);
    }
  }

  .proof {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .proof li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--color-text);
  }

  .proof :global(.proof__icon) {
    color: var(--color-accent);
  }

  @media (max-width: 40rem) {
    .hero {
      --scene-body: 3rem;
      --scene-body-end: var(--page-gutter);
      --scene-body-top: var(--space-3);
    }
  }

  .section__lead {
    margin-block-start: var(--space-4);
  }

  .section__body {
    margin-block-start: var(--space-10);
  }

  .section__more {
    margin-block-start: var(--space-8);
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--target-min);
    font-weight: var(--weight-semibold);
  }

  /* --- Process steps --- */

  .steps {
    display: grid;
    gap: var(--space-8);
    list-style: none;
    padding: 0;
    counter-reset: step;
  }

  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .step {
    padding-block-start: var(--space-4);
    border-block-start: 2px solid var(--color-link-on-band);
  }

  .step__number {
    font-family: var(--font-mono);
    font-size: var(--step-label);
    letter-spacing: var(--tracking-label);
    color: var(--color-link-on-band);
  }

  .step__title {
    margin-block-start: var(--space-3);
  }

  .step__body {
    margin-block-start: var(--space-2);
    font-size: var(--step-small);
    color: var(--color-text-dim-on-band);
  }

  /* --- Closing CTA --- */

  .cta__inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .cta__inner h2 {
    font-size: var(--step-display);
    max-width: 16ch;
  }
</style>
