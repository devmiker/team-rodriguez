---
/**
 * Businesses the studio promotes.
 *
 * Same pending behaviour as the team page: while nothing is published the page says
 * so, honestly, and is not indexed.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PartnerCard from "../components/PartnerCard.astro";
import PendingNotice from "../components/PendingNotice.astro";
import { toLocale } from "../i18n/locales";
import { pathFor } from "../i18n/routes";
import { useTranslations } from "../i18n/ui";
import { publishedPartners } from "../data/partners";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const partners = publishedPartners();
---

<BaseLayout
  page={{ route: "partners" }}
  title={t("partners.title")}
  description={t("partners.description")}
  noindex={partners.length === 0}
>
  <PageHero
    eyebrow={t("home.partners.eyebrow")}
    heading={t("partners.heading")}
    lead={t("partners.lead")}
  />

  <section class="section">
    <div class="page">
      {
        partners.length > 0 ? (
          <div class="grid grid--3">
            {partners.map((partner) => (
              <PartnerCard partner={partner} locale={locale} />
            ))}
          </div>
        ) : (
          <PendingNotice
            message={t("partners.pending")}
            actionHref={pathFor({ route: "contact" }, locale)}
            actionLabel={t("home.cta.button")}
          />
        )
      }
    </div>
  </section>
</BaseLayout>
