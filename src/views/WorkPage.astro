---
/**
 * The work gallery.
 *
 * Two labelled sections — work done for businesses, and projects built to learn.
 * Each card previews the site and links straight out to the live thing in a new tab.
 *
 * A section with nothing published in it is omitted entirely rather than rendered
 * empty. That matters here: while the "for clients" column has nothing in it, a
 * visitor sees a page of honest practice projects, not a heading advertising an
 * absence.
 *
 * The page is only `noindex` when BOTH sections are empty — at that point there is
 * genuinely nothing on it.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PendingNotice from "../components/PendingNotice.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { toLocale } from "../i18n/locales";
import { pathFor } from "../i18n/routes";
import { useTranslations } from "../i18n/ui";
import { projectsIn, publishedProjects, PROJECT_CATEGORIES } from "../data/work";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const sections = PROJECT_CATEGORIES.map((category) => ({
  category,
  projects: projectsIn(category),
  heading: t(`work.category.${category}` as Parameters<typeof t>[0]),
  blurb: t(`work.category.${category}Blurb` as Parameters<typeof t>[0]),
})).filter((section) => section.projects.length > 0);

const anything = publishedProjects().length > 0;
---

<BaseLayout
  page={{ route: "work" }}
  title={t("work.title")}
  description={t("work.description")}
  noindex={!anything}
>
  <PageHero heading={t("work.heading")} lead={t("work.lead")} />

  {
    anything ? (
      sections.map((section) => (
        <section class="section" aria-labelledby={`work-${section.category}`}>
          <div class="page">
            <div class="group__head" data-reveal="text">
              <h2 id={`work-${section.category}`}>{section.heading}</h2>
              <p class="lead">{section.blurb}</p>
            </div>

            <div class="grid grid--2 group__body" data-reveal-group>
              {section.projects.map((project) => (
                <ProjectCard project={project} locale={locale} />
              ))}
            </div>
          </div>
        </section>
      ))
    ) : (
      <section class="section">
        <div class="page">
          <PendingNotice
            message={t("work.pending")}
            actionHref={pathFor({ route: "contact" }, locale)}
            actionLabel={t("home.cta.button")}
          />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* The second section and onwards sit closer to the one above, so the page reads as
     one gallery with two headings rather than as two separate pages stacked. */
  section + section {
    padding-block-start: 0;
  }

  .group__head {
    max-width: var(--measure);
  }

  .group__head .lead {
    margin-block-start: var(--space-3);
  }

  .group__body {
    margin-block-start: var(--space-10);
  }
</style>
