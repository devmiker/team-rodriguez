---
/**
 * The banner at the top of an inner page: eyebrow, h1, and a lead paragraph.
 *
 * Every inner page uses it, so every page has exactly one h1 and they all sit at the
 * same place in the document. That consistency is what makes heading navigation
 * useful to a screen-reader user.
 */
import Scenery from "./Scenery.astro";

interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
}

const { eyebrow, heading, lead } = Astro.props;
---

<div class="hero">
  {/* Seeded by the heading, so each inner page has its own stretch of forest. */}
  <Scenery seed={heading} />
  <div class="page" data-enter>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{heading}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</div>

<style>
  .hero {
    --scene-forest: clamp(3.5rem, 9vw, 6.5rem);
    --scene-body: clamp(3rem, 8vw, 6rem);
    --scene-body-top: var(--space-6);
    position: relative;
    isolation: isolate;
    padding-block: var(--rhythm-tight) calc(var(--rhythm-tight) + var(--scene-forest));
    border-block-end: 1px solid var(--color-line);
    background:
      radial-gradient(
        60rem 20rem at 8% -10%,
        color-mix(in oklab, var(--brand-emerald) 12%, transparent),
        transparent 70%
      ),
      var(--color-bg);
  }

  h1 {
    margin-block-start: var(--space-3);
    max-width: 18ch;
  }

  .lead {
    margin-block-start: var(--space-5);
  }
</style>
